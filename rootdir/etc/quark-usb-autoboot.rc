# Keep the physical boot preference outside encrypted/user data.
on post-fs
    mkdir /persist/quark_usb_boot 0770 system system
    restorecon_recursive /persist/quark_usb_boot

# Read only this preference via a short-lived, read-only view of persist.
# No calibration files are written and the normal /persist mount is untouched.
on charger
    setprop sys.quark.usb_autoboot_enabled 0
    setprop sys.quark.usb_autoboot_active 0
    mkdir /dev/quark-usb-pref 0750 root system
    wait /dev/block/platform/msm_sdcc.1/by-name/persist 5
    mount ext4 /dev/block/platform/msm_sdcc.1/by-name/persist /dev/quark-usb-pref ro nosuid nodev noexec noatime noload
    exec - system system -- /system/bin/quark-usb-autoboot --read-preference
    umount /dev/quark-usb-pref
    start quark-usb-autoboot

service quark-usb-autoboot /system/bin/quark-usb-autoboot
    class charger
    user system
    group system
    disabled
    oneshot

# Also clean up before a stock/manual transition out of charger mode.
on property:sys.boot_from_charger_mode=1 && property:ro.bootmode=charger
    umount /dev/quark-usb-pref

# Leave the stock/manual charger transition unchanged. Only the helper sets
# this marker, after the owner preference and battery/USB gates have passed.
on property:sys.boot_from_charger_mode=1 && property:ro.bootmode=charger && property:sys.quark.usb_autoboot_active=1
    # class_stop charger also disables the dual-class health HAL.
    # Explicit start re-enables it so BatteryService can obtain IHealth.
    start health-hal-2-1
    # Charger mode parks cores and caps CPU frequency. Restore hardware limits
    # before continuing Android without the reboot used by the legacy charger.
    write /sys/devices/system/cpu/cpu0/online 1
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1
    copy /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    copy /sys/devices/system/cpu/cpu1/cpufreq/cpuinfo_max_freq /sys/devices/system/cpu/cpu1/cpufreq/scaling_max_freq
    copy /sys/devices/system/cpu/cpu2/cpufreq/cpuinfo_max_freq /sys/devices/system/cpu/cpu2/cpufreq/scaling_max_freq
    copy /sys/devices/system/cpu/cpu3/cpufreq/cpuinfo_max_freq /sys/devices/system/cpu/cpu3/cpufreq/scaling_max_freq
