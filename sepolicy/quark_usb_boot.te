# Physical power preference, separate from calibration files and user data.
type quark_usb_boot_config_file, file_type;
allow system_app persist_file:dir search;
allow system_app quark_usb_boot_config_file:dir { getattr search write add_name remove_name };
allow system_app quark_usb_boot_config_file:file create_file_perms;
allow charger persist_file:dir search;
allow charger quark_usb_boot_config_file:dir r_dir_perms;
allow charger quark_usb_boot_config_file:file r_file_perms;
r_dir_file(charger, sysfs_usb)
