binder_use(mm-qcamerad);
binder_call(mm-qcamerad, servicemanager);
binder_call(mm-qcamerad, system_server);

allow mm-qcamerad mpdecision:unix_stream_socket connectto;
allow mm-qcamerad socket_device:sock_file write;
allow mm-qcamerad system_server:unix_stream_socket rw_socket_perms;

type_transition mm-qcamerad camera_socket:sock_file camera_socket;
allow mm-qcamerad camera_socket:dir { search write add_name remove_name };
allow mm-qcamerad camera_socket:sock_file { create unlink getattr setattr read write };
allow mm-qcamerad camera_socket:fifo_file unlink;

# Read the legacy album; create new data only inside the camera directory.
allow mm-qcamerad system_data_root_file:dir search;
allow mm-qcamerad camera_data_file:dir { open read getattr search write add_name remove_name };
allow mm-qcamerad camera_data_file:file link;
# The migration entrypoint execs the original vendor daemon in the same domain.
allow mm-qcamerad mm-qcamerad_exec:file execute_no_trans;
allow mm-qcamerad permission_service:service_manager { find };
# libAlAisLib.so now uses a PIC finalizer; loader text relocations are not required.
