# Packaged files are distinct from mounted firmware and persistent data.
# Read permissions mirror explicit readers in the supplied stage24 policy.
attribute quark_packaged_firmware_file;
type quark_system_firmware_file, file_type, system_file_type, quark_packaged_firmware_file;
type quark_vendor_firmware_file, file_type, vendor_file_type, quark_packaged_firmware_file;
type quark_radio_seed_file, file_type, system_file_type;
type quark_vendor_region_file, file_type, vendor_file_type;

allow RIDL quark_packaged_firmware_file:dir { getattr ioctl lock open read search watch watch_reads };
